{
  "name": "github-but-fast",
  "version": "0.1.0",
  "description": "A read-only Code Mode gateway for GitHub — fewer tool calls, less context, any MCP-capable agent.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
